# Fibonaipe — environment template.
# Copy to .env and fill in. Never commit .env. Never expose server secrets to the browser (no VITE_ prefix).

# --- Runtime ---
NODE_ENV=development
PORT=8787
# Public site origin. Mutating requests must send this exact Origin (CSRF).
PUBLIC_ORIGIN=http://localhost:5173

# --- Database (server only). Supabase or Neon free Postgres. ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/fibonaipe?sslmode=require

# --- Session, cron, and encryption (generate with Node crypto; do not reuse these placeholders) ---
# Opaque guest/host tokens are stored as SHA-256. This secret signs nothing in the browser.
AUTH_SECRET=
# Header x-cron-secret for POST /api/internal/cron/purge-expired-rooms
CRON_SECRET=
# 32 raw bytes, base64. AES-256-GCM key for ClickUp/Jira tokens at rest.
INTEGRATION_KEY=

# --- SuperAdmin (comma-separated emails, lowercased at login) ---
SUPERADMIN_EMAILS=

# --- Auth provider (R2). Leave empty until magic link / Google is configured. ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REALTIME_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional free-tier realtime. If unset, the client uses HTTP polling. ---
# SUPABASE_REALTIME_URL already covers the default provider.
