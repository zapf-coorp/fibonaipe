{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": ["ES2023"],
    "paths": {
      "@fibonaipe/domain": ["./packages/domain/src/index.ts"],
      "@fibonaipe/application": ["./packages/application/src/index.ts"],
      "@fibonaipe/testing": ["./packages/testing/src/index.ts"],
      "@fibonaipe/adapter-auth-devfake": ["./packages/adapter-auth-devfake/src/index.ts"],
      "@fibonaipe/adapter-auth-supabase": ["./packages/adapter-auth-supabase/src/index.ts"],
      "@fibonaipe/adapter-exporter-csvjson": ["./packages/adapter-exporter-csvjson/src/index.ts"],
      "@fibonaipe/adapter-issuetracker-manual": ["./packages/adapter-issuetracker-manual/src/index.ts"],
      "@fibonaipe/adapter-persistence-postgres": ["./packages/adapter-persistence-postgres/src/index.ts"],
      "@fibonaipe/adapter-persistence-sqlite": ["./packages/adapter-persistence-sqlite/src/index.ts"],
      "@fibonaipe/adapter-realtime-supabase": ["./packages/adapter-realtime-supabase/src/index.ts"],
      "@fibonaipe/adapter-system": ["./packages/adapter-system/src/index.ts"]
    }
  }
}
